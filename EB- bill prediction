    {
      "cell_type": "code",
      "source": [
        "\n",
        "from fastapi import FastAPI\n",
        "from pydantic import BaseModel, Field\n",
        "from fastapi.testclient import TestClient\n",
        "\n",
        "app = FastAPI(title=\"E-Bill Prediction API\")\n",
        "\n",
        "class BillInput(BaseModel):\n",
        "    units: float = Field(gt=0, le=10000)\n",
        "\n",
        "@app.get(\"/\")\n",
        "def home():\n",
        "    return {\"message\": \"E-Bill Prediction API is working\"}\n",
        "\n",
        "@app.post(\"/predict\")\n",
        "def predict_bill(data: BillInput):\n",
        "    input_data = pd.DataFrame({\n",
        "        \"Units_Consumed\": [data.units]\n",
        "    })\n",
        "\n",
        "    prediction = model.predict(input_data)[0]\n",
        "\n",
        "    return {\n",
        "        \"units_consumed\": data.units,\n",
        "        \"predicted_bill\": round(float(prediction), 2),\n",
        "        \"currency\": \"INR\"\n",
        "    }\n",
        "\n",
        "client = TestClient(app)\n",
        "\n",
        "response = client.post(\n",
        "    \"/predict\",\n",
        "    json={\"units\": 250}\n",
        ")\n",
        "\n",
        "print(\"Status Code:\", response.status_code)\n",
        "print(\"API Response:\", response.json())\n"
